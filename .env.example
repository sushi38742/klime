# Copy this file to .env.local and fill in your values.

# Supabase — get from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# EmailJS — get from: https://dashboard.emailjs.com
# 1. Create a free account at emailjs.com
# 2. Add an Email Service (Gmail, Outlook, etc.) → copy its Service ID
# 3. Create two Email Templates and copy their Template IDs
# 4. Go to Account → API Keys → copy your Public Key
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_TEMPLATE_BOOKING=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_GUIDE_APPLY=template_xxxxxxx
